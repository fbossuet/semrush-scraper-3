SAM_USER_ID=27092570

# === NORDVPN CREDENTIALS ===
# Identifiants NordVPN pour rotation d'IP
NORDVPN_USERNAME=GoUiit26jFW834rb6g3ThRwW
NORDVPN_PASSWORD=sLAQ1xPWLPRN3XrbMqzoVzQN

# === URLS ===
# URL de connexion principale MyToolsPlan
MYTOOLSPLAN_LOGIN_URL=https://app.mytoolsplan.com/

# === CONFIGURATION DU NAVIGATEUR ===
# Timeout général du navigateur (en millisecondes)
BROWSER_TIMEOUT=60000

# Timeout de chargement de page (en millisecondes)
PAGE_LOAD_TIMEOUT=120000

# Timeout de navigation (en millisecondes)
NAVIGATION_TIMEOUT=90000

# === LOGGING ===
# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Fichier de log principal
LOG_FILE=logs/scraper.log

# === MÉTRIQUES ===
# Timeout pour la récupération des métriques (en millisecondes)
METRICS_TIMEOUT=30000

# Nombre de tentatives en cas d'échec
RETRY_ATTEMPTS=3

# === BASE DE DONNÉES ===
# Chemin vers la base de données SQLite
DB_PATH=/home/ubuntu/trendtrack-scraper-final/data/trendtrack.db

# === PERFORMANCE ===
# Délai entre les requêtes (en secondes)
REQUEST_DELAY=2

# Nombre maximum de boutiques traitées par session
MAX_SHOPS_PER_SESSION=100

# === SÉCURITÉ ===
# Activer la rotation des User-Agents
ROTATE_USER_AGENTS=true

# Activer la gestion des cookies
MANAGE_COOKIES=true

# === DÉVELOPPEMENT ===
# Mode debug (true/false)
DEBUG_MODE=false

# Activer les screenshots de debug
DEBUG_SCREENSHOTS=false

# === SCRAPER INTELLIGENT ===
# Traiter d'abord les boutiques "partial" (métriques manquantes)
PRIORITIZE_PARTIAL_SHOPS=true

# Traiter ensuite les boutiques "na" (jamais scrapées)
PROCESS_NA_SHOPS=true

# Ignorer les boutiques "completed" (déjà complètes)
IGNORE_COMPLETED_SHOPS=true

# === MAINTENANCE ===
# Activer la sauvegarde automatique de la base
AUTO_BACKUP=true

# Fréquence de sauvegarde (en heures)
BACKUP_FREQUENCY=24

# Conserver les sauvegardes (en jours)
BACKUP_RETENTION=7
