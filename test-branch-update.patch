+        shopData.shopName = shopNameMatch ? shopNameMatch[1].trim() : '';
+        const shopUrlMatch = shopInfoHtml.match(/href=["']([^"']+)["']/);
+        shopData.shopUrl = shopUrlMatch ? shopUrlMatch[1] : '';
